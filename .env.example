# Copy to .env.local. This connects real services; missing values do not enable fake accounts.
EXPO_PUBLIC_APP_MODE=connected
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the NEW FirstLane web project, not the prior mobile development project.
EXPO_PUBLIC_WEB_APP_URL=https://www.getfirstlane.com/app
EXPO_PUBLIC_WEB_BASE_PATH=/app
EXPO_PUBLIC_PADDLE_ENVIRONMENT=sandbox
EXPO_PUBLIC_PADDLE_CLIENT_TOKEN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SUPPORT_EMAIL=support@getfirstlane.com
EXPO_PUBLIC_OPERATOR_NAME=Tervlon Labs Limited
EXPO_PUBLIC_PRIVACY_URL=https://getfirstlane.com/privacy/
EXPO_PUBLIC_TERMS_URL=https://getfirstlane.com/terms/
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://getfirstlane.com/delete-account
# Publisher's existing registered identifiers. Do not rename after store registration.
FIRSTLANE_IOS_BUNDLE_ID=
FIRSTLANE_ANDROID_PACKAGE=
EAS_PROJECT_ID=
# Never put service-role keys, RevenueCat secret keys, or signing secrets in EXPO_PUBLIC_*.

# Public landing links, only after the listings actually exist
LANE_APP_STORE_URL=
LANE_GOOGLE_PLAY_URL=
