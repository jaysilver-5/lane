{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run web:build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/app", "permanent": false }],
  "rewrites": [
    { "source": "/app/_vercel/insights/:path*", "destination": "https://project-n8lqe.vercel.app/_vercel/insights/:path*" },
    { "source": "/app/_vercel/speed-insights/:path*", "destination": "https://project-n8lqe.vercel.app/_vercel/speed-insights/:path*" },
    { "source": "/app/_expo/:path*", "destination": "/_expo/:path*" },
    { "source": "/app/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/app/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
    { "key": "Cache-Control", "value": "no-cache" },
    { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
  ] }, { "source": "/_expo/static/(.*)", "headers": [
    { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
  ] }]
}
