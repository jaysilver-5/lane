{
  "name": "firstlane-driving-prep",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm ci",
    "start": "expo start --tunnel --go",
    "start:lan": "expo start --lan --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "content:check": "node scripts/check-content.mjs",
    "content:prepare": "node scripts/prepare-content.mjs",
    "release:check": "node scripts/release-check.mjs",
    "preview": "node scripts/preview-server.mjs",
    "source:check": "node scripts/check-source.mjs",
    "content:import": "node scripts/import-drafts.mjs",
    "preview:build": "node scripts/build-source-preview.mjs",
    "content:bundle": "node scripts/bundle-content.mjs",
    "prestart": "npm run content:bundle",
    "preandroid": "npm run content:bundle",
    "preios": "npm run content:bundle",
    "preweb": "npm run content:bundle",
    "preweb:export": "npm run content:bundle",
    "check": "npm run typecheck && npm test && npm run source:check && npm run content:check",
    "build:production:android": "npx eas-cli build --platform android --profile production",
    "build:production:ios": "npx eas-cli build --platform ios --profile production",
    "eas-build-post-install": "node scripts/bundle-content.mjs && node scripts/eas-preflight.mjs",
    "web:qa": "python scripts/expo-browser-regressions.py",
    "landing:build": "node scripts/build-landing.mjs",
    "landing:release": "node scripts/build-landing.mjs --release",
    "doctor": "npx expo-doctor",
    "preview:qa": "python scripts/source-preview-qa.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^8.12.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "postgres": "^3.4.7",
    "typescript": "~6.0.3"
  }
}
